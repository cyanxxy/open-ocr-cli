{
  "name": "open-gemini-ocr",
  "private": true,
  "version": "2.3.0",
  "description": "Provider-neutral multimodal OCR CLI for images, PDFs, URLs, JSON schemas, and agentic extraction, with a Gemini web app.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanxxy/gemini-ocr.git"
  },
  "homepage": "https://github.com/cyanxxy/gemini-ocr#readme",
  "bugs": {
    "url": "https://github.com/cyanxxy/gemini-ocr/issues"
  },
  "keywords": [
    "ocr",
    "gemini",
    "kimi",
    "muse",
    "openrouter",
    "openai-compatible",
    "cloudflare-ai-gateway",
    "multimodal-ocr",
    "ai-evals",
    "json-schema",
    "structured-extraction",
    "agentic-ocr",
    "command-line-tool",
    "pdf",
    "receipt-ocr",
    "invoice-ocr",
    "react",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "packages/cli"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "3.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.cli.json",
    "cli": "tsx src/cli/index.ts",
    "cli:build": "node scripts/sync-cli-skills.mjs && tsup --config tsup.cli.config.ts",
    "cli:smoke": "npm run cli:build && node packages/cli/dist/index.js --help",
    "cli:install-smoke": "node scripts/smoke-packed-cli.mjs",
    "action:smoke": "node scripts/smoke-github-action.mjs",
    "cli:pack": "npm pack ./packages/cli",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "test:run": "vitest run --maxWorkers=4",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:ui": "vitest --ui",
    "evals": "tsx evals/run.ts --suite full",
    "evals:canary": "tsx evals/run.ts --suite canary",
    "evals:benchmark": "tsx evals/run.ts --suite benchmark",
    "evals:stability": "tsx evals/run.ts --suite benchmark --repeat 3",
    "evals:matrix": "tsx evals/run-matrix.ts",
    "evals:matrix:check": "tsx evals/run-matrix.ts --suite canary --dry-run",
    "evals:setup": "tsx evals/setup-datasets.ts",
    "evals:fixtures": "python3 evals/generate_corpus.py && python3 evals/build_fixtures.py",
    "evals:report": "tsx evals/render-report.ts",
    "evals:validate": "tsx evals/validate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "html-to-text": "^10.0.0",
    "ipaddr.js": "^2.4.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.2.3",
    "react-router": "^7.9.1",
    "streamdown": "^2.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.18",
    "commander": "^14.0.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.3.0",
    "happy-dom": "^20.4.0",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  }
}
