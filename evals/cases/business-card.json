{
  "id": "business-card-template",
  "mode": "template",
  "inputPath": "evals/corpus/business-card.pdf",
  "presetId": "business-card",
  "reference": {
    "jsonPath": "evals/references/business-card.json",
    "criticalFields": ["full_name", "company", "email"]
  },
  "expectedAssertions": [
    { "type": "contains", "target": "markdown", "value": "Orbit Partners" },
    { "type": "json_field_equals", "path": "fields.full_name.value", "expected": "Nina Patel" },
    { "type": "json_field_equals", "path": "fields.company.value", "expected": "Orbit Partners" },
    { "type": "json_field_exists", "path": "fields.website.value" },
    { "type": "metric_min", "metric": "field_f1", "value": 0.7 },
    { "type": "metric_min", "metric": "critical_field_exact_match", "value": 1 },
    { "type": "pass_rate_weight", "value": 1.5 }
  ],
  "tags": ["business-card", "template", "record"]
}
