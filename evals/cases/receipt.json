{
  "id": "receipt-template",
  "mode": "template",
  "inputPath": "evals/corpus/receipt.pdf",
  "presetId": "receipt",
  "reference": {
    "jsonPath": "evals/references/receipt.json",
    "criticalFields": ["merchant_name", "transaction_date", "total"]
  },
  "expectedAssertions": [
    { "type": "contains", "target": "markdown", "value": "Market Street Grocer" },
    { "type": "json_field_equals", "path": "fields.receipt_number.value", "expected": "R-44219" },
    { "type": "json_field_equals", "path": "fields.total.value", "expected": "16.00" },
    { "type": "table_min_rows", "minRows": 3 },
    { "type": "metric_min", "metric": "field_f1", "value": 0.75 },
    { "type": "metric_min", "metric": "critical_field_exact_match", "value": 1 },
    { "type": "metric_min", "metric": "table_cell_f1", "value": 0.75 },
    { "type": "pass_rate_weight", "value": 2 }
  ],
  "tags": ["receipt", "template", "table"]
}
