{
  "compilerOptions": {
    /* ES2022 so the standard `Error(message, { cause })` form type-checks. */
    "target": "ES2022",
    "useDefineForClassFields": true,
    /* DOM libs are deliberately excluded. This package is the shared OCR engine
       consumed by the Node CLI (packages/cli) and the evals harness; there is no
       browser consumer left in this repo, so any browser API reaching the engine
       must fail typecheck instead of crashing at runtime. This mirrors
       packages/cli/tsconfig.json — do not add "DOM". */
    "lib": ["ES2023"],
    "module": "ESNext",
    /* audit M-07: skipLibCheck:false surfaces unfixable TS2307 errors from
       @google/genai .d.ts importing optional peers (@modelcontextprotocol/sdk)
       we do not install. Kept true. */
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Node is the only runtime for this code (`process.env` in logger.ts,
       `Buffer` in providers/openaiCompatible.ts). */
    "types": ["node"],

    /* Incremental typecheck; build info is cached outside the working tree. */
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo.engine",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
