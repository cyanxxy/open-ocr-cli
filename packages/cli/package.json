{
  "name": "open-ocr-cli",
  "version": "2.3.0",
  "description": "Provider-neutral multimodal OCR CLI for images, PDFs, URLs, JSON schemas, and agentic extraction with Gemini, Kimi, Muse, and OpenRouter.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanxxy/gemini-ocr.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/cyanxxy/gemini-ocr#command-line-interface",
  "bugs": {
    "url": "https://github.com/cyanxxy/gemini-ocr/issues"
  },
  "keywords": [
    "ocr",
    "gemini",
    "kimi",
    "muse",
    "openrouter",
    "openai-compatible",
    "cloudflare-ai-gateway",
    "multimodal-ocr",
    "json-schema",
    "structured-output",
    "agentic-ocr",
    "mcp-server",
    "cli",
    "command-line-tool",
    "pdf",
    "document-extraction",
    "batch-ocr"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "bin": {
    "open-ocr-cli": "dist/index.js",
    "gemini-ocr": "dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm --prefix ../.. run cli:build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@google/genai": "^2.11.0",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "@napi-rs/canvas": "^1.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "html-to-text": "^10.0.0",
    "ipaddr.js": "^2.4.0",
    "pdfjs-dist": "^5.6.205",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
