{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ocr.dev/schemas/request-v2.schema.json",
  "title": "Open OCR job request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "operation", "inputs"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "operation": { "const": "extract" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "const": "path" },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "const": "stdin" },
              "name": { "type": "string", "minLength": 1 },
              "mimeType": {
                "enum": ["application/pdf", "image/png", "image/jpeg", "image/webp", "image/gif", "image/heic", "image/heif"]
              }
            }
          }
        ]
      }
    },
    "configPath": { "type": "string", "minLength": 1 },
    "noConfig": { "type": "boolean" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["gemini", "kimi", "muse", "openrouter", "openai-compatible"] },
        "gateway": { "enum": ["direct", "cloudflare"] },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["simple", "template", "agentic"] },
        "preset": { "type": "string", "minLength": 1 },
        "contentFormat": { "enum": ["markdown", "json", "csv", "all"] },
        "schema": { "type": "object" },
        "schemaPath": { "type": "string", "minLength": 1 },
        "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "thinking": { "enum": ["minimal", "low", "medium", "high", "xhigh", "max"] },
        "progress": { "enum": ["off", "standard", "detailed"] },
        "detectImages": { "type": "boolean" },
        "detectMath": { "type": "boolean" },
        "maxTokens": { "type": "integer", "minimum": 256, "maximum": 1048576 },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "confidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "not": {
        "properties": { "schema": {}, "schemaPath": {} },
        "required": ["schema", "schemaPath"]
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "template" } }, "required": ["mode"] },
          "then": { "required": ["preset"] }
        },
        {
          "if": { "required": ["preset"] },
          "then": {
            "properties": { "mode": { "const": "template" } },
            "not": { "anyOf": [{ "required": ["schema"] }, { "required": ["schemaPath"] }] }
          }
        },
        {
          "if": { "anyOf": [{ "required": ["schema"] }, { "required": ["schemaPath"] }] },
          "then": {
            "properties": { "mode": { "const": "simple" }, "contentFormat": { "const": "json" } }
          }
        },
        {
          "if": { "properties": { "contentFormat": { "const": "csv" } }, "required": ["contentFormat"] },
          "then": { "properties": { "mode": { "const": "template" } }, "required": ["preset"] }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxTotalMb": { "type": "number", "minimum": 1, "maximum": 1048576 },
        "maxCostUsd": { "type": "number", "minimum": 0.000001, "maximum": 1000000 },
        "requestsPerMinute": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "failFast": { "type": "boolean" }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden": { "type": "boolean" },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["inline", "reference"] },
        "outputDirectory": { "type": "string", "minLength": 1 },
        "resume": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "inline" } }, "required": ["mode"] },
          "then": { "not": { "anyOf": [{ "required": ["outputDirectory"] }, { "required": ["resume"] }] } }
        }
      ]
    },
    "dryRun": { "type": "boolean" }
  },
  "allOf": [
    {
      "not": {
        "properties": { "configPath": { "type": "string" }, "noConfig": { "const": true } },
        "required": ["configPath", "noConfig"]
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "type": "array",
            "contains": {
              "anyOf": [
                { "type": "object", "properties": { "type": { "const": "stdin" } }, "required": ["type"] },
                { "type": "object", "properties": { "type": { "const": "path" }, "path": { "const": "-" } }, "required": ["type", "path"] }
              ]
            }
          }
        },
        "required": ["inputs"]
      },
      "then": { "properties": { "inputs": { "type": "array", "maxItems": 1 } } }
    }
  ]
}
