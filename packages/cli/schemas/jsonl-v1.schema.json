{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ocr.dev/schemas/jsonl-v1.schema.json",
  "title": "Open OCR extract JSONL stream record v1",
  "oneOf": [
    { "$ref": "#/$defs/document" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "inputTokens", "outputTokens", "thoughtTokens", "toolTokens", "cachedTokens", "totalTokens", "estimatedCostUsd"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "thoughtTokens": { "type": "integer", "minimum": 0 },
        "toolTokens": { "type": "integer", "minimum": 0 },
        "cachedTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "status", "source", "mode", "model", "durationMs", "attempts"],
      "properties": {
        "type": { "const": "document" },
        "version": { "const": 1 },
        "status": { "enum": ["succeeded", "partial", "failed", "skipped"] },
        "source": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["simple", "template", "agentic"] },
        "model": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "outputFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "plannedOutputFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "skipReason": { "enum": ["validated", "resumed", "cancelled", "cost-limit", "fail-fast"] },
        "partialReason": { "enum": ["readiness_not_met", "max_iterations", "tool_limit_reached", "time_budget_reached", "cost_limit_reached"] },
        "nextAction": { "enum": ["review_partial_output", "increase_max_iterations", "retry_document", "increase_timeout", "increase_max_cost"] },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "markdown": { "type": "string" },
            "json": {},
            "csv": { "type": "string" }
          },
          "minProperties": 1
        },
        "error": { "type": "string", "minLength": 1 },
        "errorDetails": { "$ref": "error-v2.schema.json" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": { "required": ["partialReason", "nextAction"] }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "required": ["error", "errorDetails"] }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "startedAt", "completedAt", "durationMs", "total", "succeeded", "partial", "failed", "skipped", "mode", "model", "usage", "costLimitReached", "discovery"],
      "properties": {
        "type": { "const": "summary" },
        "version": { "const": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["simple", "template", "agentic"] },
        "provider": { "enum": ["gemini", "kimi", "muse", "openrouter", "openai-compatible"] },
        "gateway": { "enum": ["direct", "cloudflare"] },
        "model": { "type": "string", "minLength": 1 },
        "usage": { "$ref": "#/$defs/usage" },
        "costLimitUsd": { "type": "number", "exclusiveMinimum": 0 },
        "costLimitReached": { "type": "boolean" },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unsupported", "defaultExcluded"],
          "properties": {
            "unsupported": { "type": "integer", "minimum": 0 },
            "defaultExcluded": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "error"],
      "properties": {
        "type": { "const": "error" },
        "version": { "const": 1 },
        "error": { "$ref": "error-v2.schema.json" }
      }
    }
  }
}
